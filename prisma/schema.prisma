// WhatsApp Business Admin — data model
// See docs/2026-07-24-whatsapp-business-admin-design.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & settings
// ---------------------------------------------------------------------------

enum Role {
  SYSTEM_ADMIN
  ADMIN
  AGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates         Template[]
  broadcasts        Broadcast[]
  sentMessages      Message[]          @relation("SentBy")
  conversations     Conversation[]     @relation("AssignedTo")
  apiKeys           ApiKey[]
  flows             Flow[]
  tenantMemberships TenantMembership[]
}

// External REST API keys (for /api/v1). Only the SHA-256 hash is stored.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String // shown in the UI to identify the key, e.g. "wba_live_a1b2c3"
  lastUsedAt  DateTime?
  revoked     Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// Singleton row (id = "default") holding the connected WABA credentials.
model WabaSettings {
  id                 String   @id @default("default")
  wabaId             String?
  metaAppId          String? // needed for template media-sample resumable uploads
  phoneNumberId      String?
  phoneNumberDisplay String?
  businessName       String?
  // Access token stored encrypted (AES-256-GCM) — never plaintext.
  accessTokenEnc     String?
  appSecret          String?
  webhookVerifyToken String?
  apiVersion         String   @default("v21.0")
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Tenant and WhatsApp Business Account foundation
// ---------------------------------------------------------------------------

// Persistence foundation only. Multi-tenancy is not operational in WA-01-01.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wabaAccounts      WabaAccount[]
  contacts          Contact[]      @relation("TenantContacts")
  conversations     Conversation[] @relation("TenantConversations")
  messages          Message[]      @relation("TenantMessages")
  templates         Template[]     @relation("TenantTemplates")
  flows             Flow[]         @relation("TenantFlows")
  broadcasts        Broadcast[]    @relation("TenantBroadcasts")
  tenantMemberships TenantMembership[]
  apiKeys                ApiKey[]
  outboxEvents           OutboxEvent[]
  canonicalEventOutbox   CanonicalEventOutbox[]
  canonicalDeliveries    CanonicalEventDelivery[]
  webhookDestinations    WebhookDestination[]
  outboundAttempts       OutboundSendAttempt[]
  apiLogs                ApiLog[]
  webhookEvents          WebhookEvent[]
}

// Persistence foundation only. Membership does not grant tenant authorization.
model TenantMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A Meta WhatsApp Business Account owned by a logical tenant.
model WabaAccount {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  metaWabaId     String
  name           String?
  metaAppId      String?
  accessTokenEnc String?
  appSecret          String?
  webhookVerifyToken String?
  apiVersion         String   @default("v21.0")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  phoneNumbers PhoneNumber[]

  @@unique([tenantId, metaWabaId])
  @@index([tenantId])
}

// A Meta phone number belonging to a WABA account.
model PhoneNumber {
  id                String      @id @default(cuid())
  wabaAccountId     String
  wabaAccount       WabaAccount @relation(fields: [wabaAccountId], references: [id], onDelete: Restrict)
  metaPhoneNumberId String
  displayPhone      String?
  verifiedName      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  conversations Conversation[]

  @@unique([wabaAccountId, metaPhoneNumberId])
  @@index([wabaAccountId])
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  LOCAL // created locally, not yet submitted to Meta
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

model Template {
  id              String           @id @default(cuid())
  tenantId        String?
  tenant          Tenant?          @relation("TenantTemplates", fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  language        String           @default("en_US")
  category        TemplateCategory
  status          TemplateStatus   @default(LOCAL)
  // Full component structure in WhatsApp Graph API shape.
  components      Json
  metaTemplateId  String?
  rejectionReason String?
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  broadcasts Broadcast[]
  messages   Message[]

  @@unique([name, language])
  @@index([tenantId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Contacts, conversations & messages
// ---------------------------------------------------------------------------

model Contact {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation("TenantContacts", fields: [tenantId], references: [id], onDelete: Restrict)
  waId          String    // E.164 digits, no '+'; unique per tenant when tenantId is set
  name          String?
  profileName   String? // name supplied by WhatsApp
  tags          String[]  @default([])
  notes         String?
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]
  flowLaunches        FlowLaunch[]

  @@unique([tenantId, waId])
  @@index([tenantId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id             String             @id @default(cuid())
  tenantId       String?
  tenant         Tenant?            @relation("TenantConversations", fields: [tenantId], references: [id], onDelete: Restrict)
  contactId      String
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumberId  String?
  phoneNumber    PhoneNumber?       @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  status         ConversationStatus @default(OPEN)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime?
  lastInboundAt  DateTime? // drives the 24h customer-service window
  lastPreview    String?
  assignedUserId String?
  assignedUser   User?              @relation("AssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages     Message[]
  flowLaunches FlowLaunch[]

  @@unique([tenantId, phoneNumberId, contactId])
  @@index([tenantId])
  @@index([contactId])
  @@index([phoneNumberId])
  @@index([lastMessageAt])
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED // inbound
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS
  TEMPLATE
  INTERACTIVE
  BUTTON
  REACTION
  UNSUPPORTED
}

enum OutboxPublicationState {
  PENDING
  CLAIMED
  PUBLISHED
  RETRYABLE
  TERMINAL
}

model OutboxEvent {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType       String
  contractVersion Int
  payload         Json
  state           OutboxPublicationState @default(PENDING)
  attemptCount    Int                    @default(0)
  maxAttempts     Int                    @default(5)
  nextAttemptAt   DateTime               @default(now())
  claimedBy       String?
  claimExpiresAt  DateTime?
  publishedAt     DateTime?
  failureCode     String?
  failureMessage  String?
  lastAttemptedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([state, nextAttemptAt, createdAt])
  @@index([state, claimExpiresAt])
  @@index([tenantId, createdAt])
  @@index([publishedAt])
}

model CanonicalEventOutbox {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType       String
  contractVersion Int
  payload         Json
  payloadHash     String
  occurredAt      DateTime
  recordedAt      DateTime
  createdAt       DateTime @default(now())

  deliveries CanonicalEventDelivery[]

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
}

enum CanonicalEventDeliveryState {
  PENDING
  IN_PROGRESS
  RETRY_PENDING
  ACCEPTED
  FAILED_TERMINAL
  SUSPENDED
}

enum CanonicalEventDeliveryAttemptResult {
  ACCEPTED
  RETRYABLE
  TERMINAL
  INTERRUPTED
}

model WebhookDestination {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  endpointUrl     String
  enabled         Boolean  @default(true)
  retiredAt       DateTime?
  subscriptions   String[]
  signingSecretEnc String
  secretVersion   Int      @default(1)
  lastTestAt      DateTime?
  // Endpoint URL that was replaced when in-flight/pending deliveries were
  // suspended. Preserved so an administrative resume can require explicit
  // acknowledgement that the recipient changed before re-dispatching.
  deliverySuspensionUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, enabled])
  @@index([tenantId, retiredAt])
}

model CanonicalEventDelivery {
  id             String                      @id @default(cuid())
  tenantId       String
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventId        String
  event          CanonicalEventOutbox        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  destinationId  String
  state          CanonicalEventDeliveryState @default(PENDING)
  attemptCount   Int                         @default(0)
  maxAttempts    Int                         @default(5)
  nextAttemptAt  DateTime                    @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?
  acceptedAt     DateTime?
  terminalAt     DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  attempts CanonicalEventDeliveryAttempt[]

  @@unique([tenantId, eventId, destinationId])
  @@index([state, nextAttemptAt, createdAt])
  @@index([state, leaseExpiresAt])
  @@index([tenantId, state, nextAttemptAt])
}

model CanonicalEventDeliveryAttempt {
  id             String                              @id @default(cuid())
  deliveryId     String
  delivery       CanonicalEventDelivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  leaseOwner     String
  attemptNumber  Int
  startedAt      DateTime
  completedAt    DateTime?
  httpStatus     Int?
  result         CanonicalEventDeliveryAttemptResult @default(INTERRUPTED)
  errorSummary   String?
  nextRetryAt    DateTime?
  createdAt      DateTime                            @default(now())

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, startedAt])
  @@index([result, createdAt])
}

model Message {
  id             String           @id @default(cuid())
  tenantId       String?
  tenant         Tenant?          @relation("TenantMessages", fields: [tenantId], references: [id], onDelete: Restrict)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus    @default(PENDING)
  // WhatsApp message id (wamid.*). Unique when present.
  waMessageId    String?          @unique
  text           String?
  caption        String?
  // Local media storage
  mediaPath      String?
  mediaMime      String?
  mediaFilename  String?
  // For location/interactive/etc. keep the raw structured payload.
  payload        Json?
  templateId     String?
  template       Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  errorJson      Json?
  sentById       String?
  sentBy         User?            @relation("SentBy", fields: [sentById], references: [id], onDelete: SetNull)
  flowLaunch     FlowLaunch?
  attempts       OutboundSendAttempt[]
  broadcastRecipient BroadcastRecipient?
  timestamp      DateTime         @default(now())

  // External client idempotency for POST /api/v1/messages.
  // Both nullable: requests without a key never participate in uniqueness.
  idempotencyKey         String?
  idempotencyFingerprint String?

  // Tenant-scoped external idempotency. PostgreSQL treats NULLs as distinct,
  // so unkeyed rows never collide; a key can never deduplicate across tenants.
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([conversationId, timestamp])
}

// ---------------------------------------------------------------------------
// Durable outbound execution ownership.
//
// One row per outbound send attempt. Created when a worker CLAIMS execution
// of an outbound Message. The UNCERTAIN state is a terminal, non-retryable
// guard: an expired lease on an UNCERTAIN row does NOT authorize a retry —
// the operator must explicitly retry after investigation. The schema enums
// cover the six required lifecycle states.
//
// This is the durable record that protects against duplicate Meta
// transmissions when BullMQ jobIds alone are insufficient (re-enqueue, lease
// expiry after the Meta transmission boundary, concurrent workers).
// ---------------------------------------------------------------------------

enum OutboundAttemptState {
  PENDING       // ready for initial send
  CLAIMED       // execution claimed by a worker
  SENT          // Meta accepted
  FAILED        // definitive failure (no retry)
  RETRYABLE     // safe to retry
  UNCERTAIN     // Meta outcome unknown; non-retryable automatically
}

model OutboundSendAttempt {
  id              String               @id @default(cuid())
  messageId       String
  message         Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  state           OutboundAttemptState @default(PENDING)
  attemptCount    Int                  @default(0)
  // WA-OUTRETRY-01: auto-retry bookkeeping. autoRetryCount counts ONLY
  // scheduler-initiated retries (excludes the initial attempt and any
  // manual operator retries). nextEligibleRetryAt is the earliest wall
  // clock time the scheduler may re-enqueue the message.
  autoRetryCount       Int       @default(0)
  nextEligibleRetryAt  DateTime?
  lastRetryAfterSec    Int?      // Retry-After seconds from last Meta 429/5xx
  ownerId         String?              // worker / dispatcher ID that claimed
  claimExpiresAt  DateTime?            // lease expiry; null when not CLAIMED
  metaRequestStartedAt DateTime?       // set before crossing the Meta send boundary
  waMessageId     String?              // set when Meta accepted
  lastErrorCode   String?
  lastErrorMessage String?
  lastMetaStatus  Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  claimedAt       DateTime?
  finishedAt      DateTime?

  @@index([messageId, state])
  @@index([state, claimExpiresAt])
  @@index([state, nextEligibleRetryAt])
  @@index([tenantId, state])
}

// ---------------------------------------------------------------------------
// WhatsApp Flows
// ---------------------------------------------------------------------------

enum FlowVersionStatus {
  LOCAL
  DRAFT
  PUBLISHED
  DEPRECATED
  BLOCKED
  THROTTLED
  ERROR
}

enum FlowLaunchStatus {
  PENDING
  SENT
  OPENED
  COMPLETED
  FAILED
  EXPIRED
}

enum FlowDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Flow {
  id                   String       @id @default(cuid())
  tenantId             String?
  tenant               Tenant?      @relation("TenantFlows", fields: [tenantId], references: [id], onDelete: Restrict)
  name                 String
  categories           String[]     @default(["OTHER"])
  retentionDays        Int          @default(90)
  sensitiveFields      String[]     @default([])
  completionWebhookUrl String?
  completionSecretEnc  String?
  activeVersionId      String?      @unique
  activeVersion        FlowVersion? @relation("ActiveFlowVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  versions FlowVersion[] @relation("FlowVersions")
  launches FlowLaunch[]

  @@index([tenantId])
  @@index([updatedAt])
}

model FlowVersion {
  id               String            @id @default(cuid())
  flowId           String
  flow             Flow              @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Cascade)
  revision         Int
  status           FlowVersionStatus @default(LOCAL)
  metaFlowId       String?           @unique
  jsonVersion      String            @default("7.3")
  dataApiVersion   String?
  flowJson         Json
  validationErrors Json?
  endpointEnabled  Boolean           @default(false)
  previewUrl       String?
  previewExpiresAt DateTime?
  clonedFromId     String?
  clonedFrom       FlowVersion?      @relation("FlowVersionClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones           FlowVersion[]     @relation("FlowVersionClone")
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  activeFor Flow?               @relation("ActiveFlowVersion")
  bindings  FlowActionBinding[]
  launches  FlowLaunch[]

  @@unique([flowId, revision])
  @@index([status])
}

model FlowConnector {
  id            String   @id @default(cuid())
  name          String   @unique
  baseUrl       String
  allowedHosts  String[]
  authType      String   @default("NONE")
  authConfigEnc String?
  timeoutMs     Int      @default(5000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bindings    FlowActionBinding[]
  invocations FlowConnectorInvocation[]
}

model FlowActionBinding {
  id              String        @id @default(cuid())
  flowVersionId   String
  flowVersion     FlowVersion   @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  screen          String
  action          String
  connectorId     String
  connector       FlowConnector @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  requestMapping  Json
  responseMapping Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([flowVersionId, screen, action])
}

model FlowLaunch {
  id             String           @id @default(cuid())
  flowId         String
  flow           Flow             @relation(fields: [flowId], references: [id], onDelete: Restrict)
  flowVersionId  String
  flowVersion    FlowVersion      @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?          @unique
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  tokenHash      String           @unique
  tokenPrefix    String
  status         FlowLaunchStatus @default(PENDING)
  initialDataEnc String?
  entryScreen    String?
  error          String?
  expiresAt      DateTime
  openedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  submission FlowSubmission?

  @@index([flowId, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
}

model FlowSubmission {
  id           String     @id @default(cuid())
  launchId     String     @unique
  launch       FlowLaunch @relation(fields: [launchId], references: [id], onDelete: Cascade)
  waMessageId  String?    @unique
  responseEnc  String?
  responseKeys String[]   @default([])
  purgedAt     DateTime?
  completedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())

  deliveries FlowDeliveryAttempt[]

  @@index([completedAt])
}

model FlowDeliveryAttempt {
  id             String             @id @default(cuid())
  submissionId   String
  submission     FlowSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status         FlowDeliveryStatus @default(PENDING)
  attempt        Int                @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, nextAttemptAt])
}

model FlowConnectorInvocation {
  id             String        @id @default(cuid())
  connectorId    String
  connector      FlowConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  launchId       String?
  screen         String?
  action         String?
  responseStatus Int?
  ok             Boolean       @default(false)
  durationMs     Int?
  error          String?
  createdAt      DateTime      @default(now())

  @@index([connectorId, createdAt])
}

model FlowEncryptionKey {
  id            String    @id @default(cuid())
  fingerprint   String    @unique
  publicKeyPem  String
  privateKeyEnc String
  active        Boolean   @default(false)
  registeredAt  DateTime?
  retireAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([active])
}

// ---------------------------------------------------------------------------
// Broadcasts
// ---------------------------------------------------------------------------

enum BroadcastStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Broadcast {
  id          String          @id @default(cuid())
  tenantId    String?
  tenant      Tenant?         @relation("TenantBroadcasts", fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  templateId  String
  template    Template        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  // Positional variable values shared across recipients (component params).
  variables   Json?
  status      BroadcastStatus @default(DRAFT)
  total       Int             @default(0)
  sentCount   Int             @default(0)
  failedCount Int             @default(0)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recipients BroadcastRecipient[]

  @@index([tenantId])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      RecipientStatus @default(PENDING)
  waMessageId String?         @unique
  messageId   String?         @unique
  message     Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([broadcastId, contactId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit logs
// ---------------------------------------------------------------------------

// Every OUTBOUND Graph API call, written automatically by graphFetch().
model ApiLog {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  method         String
  endpoint       String
  requestBody    Json?
  responseStatus Int?
  responseBody   Json?
  ok             Boolean  @default(false)
  durationMs     Int?
  relatedType    String? // e.g. "template", "message", "broadcast"
  relatedId      String?
  requestHeaders Json?
  responseHeaders Json?
  wabaId         String?
  phoneNumberId  String?
  attemptId      String?
  jobId          String?
  attemptNumber  Int?
  error          String?
  requestTruncated Boolean @default(false)
  responseTruncated Boolean @default(false)
  payloadExpiresAt DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([relatedType, relatedId])
  @@index([payloadExpiresAt])
}

// Every INBOUND webhook POST, raw payload stored before processing.
model WebhookEvent {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payload        Json
  headers        Json?
  signatureValid Boolean  @default(false)
  processedOk    Boolean  @default(false)
  eventSummary   String? // short human label, e.g. "message from 9199..., 1 status"
  error          String?
  wabaId         String?
  phoneNumberId  String?
  processingStage String?
  payloadTruncated Boolean @default(false)
  payloadExpiresAt DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
