# ERA 5 test environment
# Used ONLY by WA-ERA5 testing. Never sourced by main application.
# Source via: set -a && source .env.era5 && set +a

# ---- App ----
NODE_ENV=test
PORT=4030
APP_URL=http://localhost:4030
# Local-only AUTH_URL for browser test; tunnel is NOT used in ERA 5 isolation.
AUTH_URL=http://localhost:4030

# ---- Auth (Auth.js v5) ----
AUTH_SECRET=era5_test_only_secret_2ba9ed268c0b2da4002d42acdf80132cf42100ebd1c445126198d8261db7c918
AUTH_TRUST_HOST=true

# ---- Database (isolated from wa_admin) ----
DATABASE_URL=postgresql://wa:wa@localhost:5434/whatsapp_era5_test?schema=public

# ---- Encryption for the WhatsApp access token at rest ----
ENCRYPTION_KEY=daa59decb41536a1f0bf0d095b6fe6dd001b3e27e2b74bcef42df5db56ec2040

# ---- Media storage ----
MEDIA_DIR=./storage/media-era5

# ---- WhatsApp Cloud API defaults ----
GRAPH_API_VERSION=v21.0
REDIS_URL=redis://127.0.0.1:6379
# Typing-indicator capability (Meta's combined mark-read + typing endpoint).
# Default in code is false; enable explicitly for environments that need it.
WHATSAPP_TYPING_ENABLED=true

# ---- ERA 5 isolation: BullMQ namespace distinct from default "wa-queue" ----
BULLMQ_PREFIX=wa-queue-era5
BULLMQ_WORKER_CONCURRENCY=1

# ---- Auth bootstrap guard: prevents accidental seed auto-run ----
# WBA_ALLOW_DEMO_SEED is intentionally NOT set; SEED_ADMIN_PASSWORD is not configured.
# Seed scripts will refuse to run against this environment unless explicitly opted in.
