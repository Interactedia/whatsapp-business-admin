[Unit]
Description=WhatsApp Business Admin Outbox Dispatcher
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=wa-admin
Group=wa-admin
WorkingDirectory=/opt/whatsapp-business-admin
EnvironmentFile=/etc/whatsapp-business-admin/era5.env
ExecStart=/usr/bin/env npm exec -- tsx scripts/outbox-dispatcher.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
