# ---- App ----
NODE_ENV=development
PORT=3000
# Public URL Meta will call for webhooks and the encrypted Flow data endpoint.
# Dynamic Flows require public HTTPS (use a tunnel like ngrok in development).
APP_URL=http://localhost:3000

# ---- Auth (Auth.js v5) ----
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_TRUST_HOST=true

# ---- Database ----
DATABASE_URL=postgresql://wa:wa@localhost:5434/wa_admin?schema=public

# ---- Encryption for the WhatsApp access token at rest (AES-256-GCM) ----
# Must be 32 bytes hex (64 hex chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# ---- Media storage ----
MEDIA_DIR=./storage/media

# ---- WhatsApp Cloud API defaults (per-WABA values are set in the app UI/Settings) ----
GRAPH_API_VERSION=v21.0

# ---- Redis (optional — required only for BullMQ queue infrastructure) ----
# Standard Redis connection URL. Example: redis://localhost:6379
# For authenticated Redis: redis://user:password@host:port
# When absent, the application starts without Redis (queue features inactive).
REDIS_URL=redis://localhost:6379

# Connection timeout in milliseconds. Default: 5000.
# REDIS_CONNECT_TIMEOUT_MS=5000

# Maximum retry attempts on transient connection failures. Default: 3.
# Set to 0 to disable retries (fail-fast mode).
# REDIS_MAX_RETRIES=3
